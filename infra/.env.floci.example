# Copy to infra/.env.floci (git-ignored) or let `bash infra/deploy.sh` generate it with random values.
# These values are uploaded to AWS Secrets Manager (one secret per service) and are never committed.

# Postgres owner (migrations only; the services never use it)
PG_OWNER_PASSWORD=CHANGE_ME
# Per-service database roles (each service has its own role and password)
AUTH_DB_PASSWORD=CHANGE_ME
SUPPLIER_DB_PASSWORD=CHANGE_ME
ORDER_DB_PASSWORD=CHANGE_ME
EVALUATION_DB_PASSWORD=CHANGE_ME
# Token signing secrets (48+ random characters)
JWT_SECRET=CHANGE_ME
INTERNAL_JWT_SECRET=CHANGE_ME
# First admin account (created once by scripts/db-setup.js)
ADMIN_EMAIL=admin@ses.local
ADMIN_PASSWORD=CHANGE_ME
# Optional ExchangeRate-API key (https://www.exchangerate-api.com). Empty = open-access endpoint.
EXCHANGE_API_KEY=
# Where the Lambda containers find Postgres (Docker network name) and where this PC finds it.
DB_HOST_FOR_LAMBDA=ses-postgres:5432
DB_HOST_FOR_SETUP=localhost:5432
DB_NAME=supplierdb
# Neon instead of local Postgres: set DB_HOST_FOR_LAMBDA and DB_HOST_FOR_SETUP to <your-neon-host>,
# DB_NAME=neondb and DB_SSL=require
DB_SSL=
