# Local development settings. `npm run local` creates .env.local with RANDOM values automatically,
# so you normally never copy this file. Names only - never put real values in a committed file.
PG_PORT=5433
PG_SUPERUSER_PASSWORD=
AUTH_DB_PASSWORD=
SUPPLIER_DB_PASSWORD=
ORDER_DB_PASSWORD=
EVALUATION_DB_PASSWORD=
JWT_SECRET=
INTERNAL_JWT_SECRET=
ADMIN_EMAIL=admin@ses.local
ADMIN_PASSWORD=
ADMIN_NAME=Procurement Admin
# optional ExchangeRate-API key (empty = open-access endpoint)
EXCHANGE_API_KEY=
APPROVAL_THRESHOLD_EGP=50000
# created by `npm run seed:demo`
DEMO_STAFF_PASSWORD=
